#!/bin/sh
# scwrote <file|folder> — open a scwrote window running nvim on it.
#
# Runs the app's binary directly instead of through `open`, so the app is a
# child of this shell and inherits its environment (PATH, etc.) and working
# directory. Apps started with `open` get a minimal environment instead.

# Follow symlinks back to where this script really lives.
script="$0"
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case "$target" in
    /*) script="$target" ;;
    *) script="$(dirname "$script")/$target" ;;
  esac
done
root=$(cd "$(dirname "$script")/.." && pwd)

# Installed by install.sh: <prefix>/bin/scwrote runs <prefix>/share/scwrote/Scwrote.
# Run from the repo: bin/scwrote runs the latest release build.
if [ -x "$root/share/scwrote/Scwrote" ]; then
  app="$root/share/scwrote/Scwrote"
elif [ -x "$root/.build/release/Scwrote" ]; then
  app="$root/.build/release/Scwrote"
else
  echo "scwrote: no build found. Run ./install.sh in the scwrote repo." >&2
  exit 1
fi

if [ "${1:-}" = "--version" ]; then
  version=$(cat "$(dirname "$app")/VERSION" 2>/dev/null) || version=0.0.0-dev
  echo "scwrote ${version:-0.0.0-dev}"
  exit 0
fi

# Start the app detached (nohup), so closing the terminal doesn't take the
# window with it.
#
# Then wait: macOS only lets a new app take focus while it still descends from
# the app you're typing in, so if this script exited now, the window would open
# behind your terminal. The app sends SIGUSR1 once it's in front; after 5
# seconds we give the prompt back regardless.
log="$HOME/Library/Logs/scwrote.log"
trap 'kill "$timer" 2>/dev/null; exit 0' USR1
SCWROTE_NOTIFY_PID=$$ nohup "$app" "$@" </dev/null >>"$log" 2>&1 &
sleep 5 &
timer=$!
wait "$timer"
